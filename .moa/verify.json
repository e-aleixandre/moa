{
  "checks": [
    {
      "name": "build",
      "command": "go build ./...",
      "timeout": "5m"
    },
    {
      "name": "vet",
      "command": "go vet ./...",
      "timeout": "5m"
    },
    {
      "name": "test",
      "command": "go test -race -count=1 ./...",
      "timeout": "15m"
    },
    {
      "name": "lint",
      "command": "PATH=\"$PATH:$(go env GOPATH)/bin\" golangci-lint run ./...",
      "timeout": "5m"
    }
  ]
}
