{
  "name": "moa-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Native container around the moa frontend. Not part of the moa binary.",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --ios --android",
