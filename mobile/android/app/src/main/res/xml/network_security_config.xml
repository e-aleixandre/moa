<?xml version="1.0" encoding="utf-8"?>
<!--
  No cleartext anywhere, and only the system's certificate authorities: a moa
  server is paired over HTTPS with a real certificate (pairing refuses http).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
