{
  "appId": "com.ealeixandre.moa.app",
  "appName": "moa",
  "webDir": "www",
  "server": {
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#11111b",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": false
  },
  "android": {
    "backgroundColor": "#11111b"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    }
  }
}
