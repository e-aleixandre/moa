{
  "appId": "com.ealeixandre.moa.app",
  "appName": "moa",
  "webDir": "www",
  "server": {
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#11111b",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": false,
    "handleApplicationNotifications": false
  },
  "android": {
    "includePlugins": [
      "@capacitor/haptics",
      "@capacitor/share",
      "@capacitor/status-bar"
    ],
    "backgroundColor": "#11111b",
    "allowMixedContent": false
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    },
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
