<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Simulator only: App.entitlements plus the CarPlay key, passed on the
     xcodebuild command line (CODE_SIGN_ENTITLEMENTS=App/App-CarPlaySim.entitlements).
     Never used for a device build: Apple has not granted the CarPlay
     entitlement yet, and App.entitlements must keep signing as it does. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-voice-based-conversation</key>
	<true/>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(MOA_APP_GROUP_IDENTIFIER)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<string>$(AppIdentifierPrefix)$(MOA_PUSH_KEYCHAIN_GROUP)</string>
	</array>
</dict>
</plist>
