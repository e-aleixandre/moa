{
  "name": "moa-push-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  },
  "ratelimits": [
    {
      "name": "SEND_LIMITER",
